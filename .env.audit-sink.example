# Audit sink (external machine). See README "Audit log".

# Shared secret; must equal REGBY_AUDIT_TOKEN on the broker. At least 32
# characters, e.g. `openssl rand -hex 32`.
REGBY_AUDIT_TOKEN=

# Records older than this many days are deleted (hourly). Default 365.
REGBY_AUDIT_RETAIN_DAYS=365

# Hard cap on stored records; past it the oldest go first. Default 10000000.
REGBY_AUDIT_MAX_ROWS=10000000

# Local runs only (compose pins these): SQLite path, bind host and port.
# The folder is forced to 0700 and the file to 0600.
# REGBY_AUDIT_DB_PATH=audit.db
# REGBY_AUDIT_HOST=127.0.0.1
# REGBY_AUDIT_PORT=8787

# Compose only: host folder mounted at /audit. Defaults to ./audit-data.
# REGBY_AUDIT_DATA_DIR=./audit-data

# log level: error | warn | info | debug
REGBY_LOG_LEVEL=info
