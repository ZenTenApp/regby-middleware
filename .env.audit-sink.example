# Audit sink, beside the broker (docker-compose.audit.yml). See docs/deployment.md "Adding the audit sink".

# Shared secret; must equal REGBY_AUDIT_TOKEN on the broker. At least 32
# characters, e.g. `openssl rand -hex 32`.
REGBY_AUDIT_TOKEN=

# Postgres holding the history. Only the sink gets these, never the broker.
# TLS is always verified against the CA file; URL params like ?sslmode= are ignored.
REGBY_AUDIT_DATABASE_URL=postgres://user:password@host:port/database
# CA the database's TLS certificate must chain to. Compose pins this to the
# mounted /certs/db-ca.pem; set it only for local runs.
# REGBY_AUDIT_DATABASE_CA=certs/db-ca.pem

# Records older than this many days are deleted (hourly). Default 365.
REGBY_AUDIT_RETAIN_DAYS=365

# Hard cap on stored records; past it the oldest go first. Default 10000000.
REGBY_AUDIT_MAX_ROWS=10000000

# Local runs only (compose pins these): bind host and port.
# REGBY_AUDIT_HOST=127.0.0.1
# REGBY_AUDIT_PORT=8787

# log level: error | warn | info | debug
REGBY_LOG_LEVEL=info
