{
  "name": "regby-middleware",
  "version": "0.1.0",
  "private": true,
  "description": "Nostr middleman broker for ReGBY — BLIK-style coded payment requests (mints/redeems 6-digit codes over NIP-44 encrypted events).",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "nostr-tools": "^2.23.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
